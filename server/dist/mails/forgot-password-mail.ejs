<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Skoob Invoice – Reset Password</title>
    <style>
      /* Base Styles */
      body {
        margin: 0;
        padding: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        background-color: #f8f9fb;
        color: #2c3e50;
        -webkit-font-smoothing: antialiased;
      }

      a {
        text-decoration: none;
      }

      .wrapper {
        width: 100%;
        background-color: #f8f9fb;
        table-layout: fixed;
        padding: 40px 0;
      }

      .container {
        max-width: 580px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        border: 1px solid #eaeef2;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        overflow: hidden;
      }

      /* Header */
      .header {
        background: linear-gradient(135deg, #1e3a8a 0%, #172554 100%);
        color: #ffffff;
        text-align: center;
        padding: 40px 24px;
        border-bottom: 3px solid #c5a059; /* Premium gold accent */
      }

      .header h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 500;
        letter-spacing: 1px;
        text-transform: uppercase;
      }

      /* Body */
      .body {
        padding: 40px 36px;
      }

      .body p {
        font-size: 15px;
        line-height: 1.7;
        color: #4a5568;
        margin: 0 0 20px 0;
      }

      .body p.greeting {
        font-size: 17px;
        color: #1a202c;
      }

      /* Button Container */
      .button-container {
        text-align: center;
        margin: 32px 0;
      }

      /* Premium Button */
      .button {
        display: inline-block;
        background: linear-gradient(135deg, #1e3a8a 0%, #172554 100%);
        color: #ffffff !important;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.5px;
        padding: 16px 36px;
        border-radius: 8px;
        box-shadow: 0 4px 12px rgba(11, 19, 43, 0.15);
        transition: all 0.2s ease;
      }

      .button:hover {
        background-color: #1c2a4f;
      }

      /* Divider */
      .divider {
        height: 1px;
        background-color: #edf2f7;
        margin: 30px 0;
      }

      /* Footer */
      .footer {
        background-color: #fcfcfd;
        text-align: center;
        font-size: 13px;
        padding: 28px 24px;
        color: #718096;
        border-top: 1px solid #edf2f7;
      }

      .footer p {
        margin: 6px 0;
        line-height: 1.5;
      }

      .footer a {
        color: #0b132b;
        font-weight: 600;
        text-decoration: underline;
      }

      /* Responsive */
      @media screen and (max-width: 600px) {
        .wrapper {
          padding: 10px;
        }
        .container {
          border-radius: 8px;
        }
        .body {
          padding: 28px 20px;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->
        <div class="header">
          <h1>Password Reset Request</h1>
        </div>

        <!-- Body -->
        <div class="body">
          <p class="greeting">Hello <strong><%= user.name %></strong>,</p>
          <p>
            We received a request to reset your password for your
            <strong>Skoob Invoice</strong> account. Click the secure button
            below to set a new password. This link will expire in
            <strong>5 minutes</strong>.
          </p>

          <div class="button-container">
            <a href="<%= resetUrl %>" class="button">Reset Password</a>
          </div>

          <div class="divider"></div>

          <p style="font-size: 13px; color: #a0aec0; margin-bottom: 0">
            If you didn’t request a password reset, you can safely ignore this
            email—your password will remain unchanged.
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>
            Need assistance? Contact our concierge team at
            <a href="mailto:support@skoob.com">support@skoob.com</a>
          </p>
          <p style="color: #cbd5e0; margin-top: 12px">
            &copy; <%= new Date().getFullYear() %> Skoob Invoice. All rights
            reserved.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
